# Storyteller Magic Environment Variables
# Copy this file to .env.local and add your values

# Server-side Gemini API key (used by server/story-api.mjs)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API key for premium TTS (/api/tts).
# If omitted, app falls back to browser Speech Synthesis voices.
OPENAI_API_KEY=your_openai_api_key_here

# Optional security controls for server/story-api.mjs
# Trust x-forwarded-for / x-real-ip only when behind a trusted reverse proxy.
# TRUST_PROXY=false
# Comma-separated browser origin allowlist used by CORS (set in production).
# Example: CORS_ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
# CORS_ALLOWED_ORIGINS=

# Optional: OpenAI TTS tuning knobs
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_VOICE_TR=alloy
# OPENAI_TTS_VOICE_EN=alloy
# OPENAI_TTS_FORMAT=mp3

# Optional: public URL for the story API.
# Leave empty when frontend and API are served from the same origin.
# For local web development with `npm run dev` + `npm run dev:api`,
# you can keep it empty and use Vite's /api proxy.
VITE_STORY_API_URL=

# Optional: choose story generation strategy on client.
# local  -> no API cost, uses built-in story pool + local composition (default)
# hybrid -> tries API first, falls back to local pool
# remote -> always uses API
# VITE_STORY_GENERATION_MODE=local

# Optional: force illustrated covers in UI instead of original story images.
# Disabled by default. Set to true to enable illustration-only mode.
# VITE_ILLUSTRATION_ONLY_MODE=true

# Optional: force one illustration technique globally.
# Allowed: watercolor, gouache, flat-storybook, cut-paper
# If not set, technique is selected automatically by theme and age range.
# VITE_ILLUSTRATION_STYLE_OVERRIDE=

# Optional: local dev proxy target for Vite (/api -> target).
# Defaults to http://localhost:8787 when not set.
# STORY_API_PROXY_TARGET=http://localhost:8787

# Optional: override Openverse audio API base used by `npm run audio:sync`.
# OPENVERSE_API_BASE_URL=https://api.openverse.engineering/v1/audio/
