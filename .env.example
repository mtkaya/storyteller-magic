# ===========================
# MONETIZATION (Production)
# ===========================

# RevenueCat Web SDK key (get from app.revenuecat.com → Projects → API Keys)
# Leave empty to use mock/test mode
VITE_REVENUECAT_KEY=

# RevenueCat iOS native key (optional, for native iOS builds)
REVENUECAT_IOS_KEY=

# RevenueCat Android native key (optional, for native Android builds)
REVENUECAT_ANDROID_KEY=

# OpenAI TTS Key (get from platform.openai.com → API Keys)
# Leave empty to use browser Speech Synthesis (free but robotic)
# With key: natural human-like voices (nova, shimmer, onyx...)
# Cost: ~$0.015 per 1K characters (~$0.03 per story reading)
VITE_OPENAI_TTS_KEY=

# ElevenLabs API Key for premium TTS (get from elevenlabs.io → API Keys)
# Leave empty to use browser Speech Synthesis only
ELEVENLABS_API_KEY=

# ElevenLabs voice IDs (optional, defaults provided)
ELEVENLABS_VOICE_EN=21m00Tcm4TlvDq8ikWAM  # Rachel (female, US)
ELEVENLABS_VOICE_TR=pNInz6obpgDQGcFmaJgB  # Adam (male, deep)
